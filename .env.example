# Main API
PORT=3000
DATABASE_URL="postgresql://contrava:contrava@localhost:5432/contrava?connection_limit=10&pool_timeout=10"
TEST_DATABASE_URL="postgresql://contrava:contrava@localhost:5432/contrava_test?connection_limit=20&pool_timeout=10"
SPEC_WORKER_URL=http://localhost:3001
SCAN_WORKER_URL=http://localhost:3002
SCAN_RUNNER_URL=http://localhost:3003
REPO_SCAN_RUNNER_URL=http://localhost:3004
WORKER_TIMEOUT_MS=5000
SCHEDULER_INTERVAL_MS=10000
JOB_POLL_INTERVAL_MS=1000
JOB_LEASE_MS=30000
JOB_HEARTBEAT_MS=10000
MAX_CONCURRENT_JOBS=2
MAX_JOB_ATTEMPTS=4
JOB_RETENTION_DAYS=30
JOB_DELIVERY_MODE=rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PREFETCH=2
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
RABBITMQ_REPO_SCAN_QUEUE=contrava.repository.scan
REPO_SCAN_PREFETCH=1
REPO_SCAN_LEASE_MS=60000
REPO_SCAN_HEARTBEAT_MS=15000
REPO_SCAN_CONCURRENCY=4
REPO_MAX_FILES=5000
REPO_MAX_FILE_BYTES=524288
REPO_MAX_TOTAL_BYTES=52428800
GITHUB_API_URL=https://api.github.com
GITHUB_MAX_RESPONSE_BYTES=10485760
GITHUB_TOKEN=
API_JSON_BODY_LIMIT=10mb
RUNNER_FAILURE_RATE=0

# Workers
SPEC_WORKER_PORT=3001
SCAN_WORKER_PORT=3002
SCAN_RUNNER_PORT=3003
REPO_SCAN_RUNNER_PORT=3004
SPEC_FETCH_TIMEOUT_MS=8000
SPEC_MAX_BYTES=5242880

# Web (read when Vite starts)
VITE_API_URL=http://localhost:3000
