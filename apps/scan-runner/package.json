    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@contrava/shared": "*",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}
