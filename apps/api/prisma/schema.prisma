generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApiStatus {
  PENDING
  ACTIVE
  ERROR
}

enum ScanStatus {
  RUNNING
  RETRY_SCHEDULED
  COMPLETED
  FAILED
}

enum ScanJobStatus {
  PENDING
  CLAIMED
  RUNNING
  RETRY_SCHEDULED
  COMPLETED
  FAILED
}

enum ScanJobSource {
  MANUAL
  SCHEDULED
}

enum ChangeSeverity {
  NON_BREAKING
  POTENTIALLY_BREAKING
  BREAKING
}

enum WorkerStatus {
  UNKNOWN
  HEALTHY
  UNAVAILABLE
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model TrackedApi {
  id                  String        @id @default(uuid()) @db.Uuid
  name                String        @db.VarChar(120)
  specUrl             String
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  lastCheckedAt       DateTime?     @db.Timestamptz(3)
  status              ApiStatus     @default(PENDING)
  scanEnabled         Boolean       @default(false)
  scanIntervalMinutes Int           @default(60)
  nextScanAt          DateTime?     @db.Timestamptz(3)
  snapshots           ApiSnapshot[]
  changes             ApiChange[]
  scans               Scan[]
  jobs                ScanJob[]
  outboxMessages      OutboxMessage[]

  @@index([scanEnabled, nextScanAt])
}

model ApiSnapshot {
  id              String      @id @default(uuid()) @db.Uuid
  apiId           String      @db.Uuid
  contentHash     String      @db.VarChar(64)
  rawSpec         Json        @db.JsonB
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  api             TrackedApi  @relation(fields: [apiId], references: [id], onDelete: Cascade)
  previousChanges ApiChange[] @relation("PreviousSnapshot")
  currentChanges  ApiChange[] @relation("CurrentSnapshot")

  @@unique([apiId, contentHash])
  @@index([apiId, createdAt])
}

model ApiChange {
  id                 String         @id @default(uuid()) @db.Uuid
  apiId              String         @db.Uuid
  previousSnapshotId String         @db.Uuid
  currentSnapshotId  String         @db.Uuid
  severity           ChangeSeverity
  category           String         @db.VarChar(80)
  path               String
  method             String?        @db.VarChar(12)
  description        String
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  api                 TrackedApi     @relation(fields: [apiId], references: [id], onDelete: Cascade)
  previousSnapshot   ApiSnapshot    @relation("PreviousSnapshot", fields: [previousSnapshotId], references: [id], onDelete: Cascade)
  currentSnapshot    ApiSnapshot    @relation("CurrentSnapshot", fields: [currentSnapshotId], references: [id], onDelete: Cascade)

  @@index([apiId, createdAt])
  @@unique([previousSnapshotId, currentSnapshotId, category, path, method, description])
}

model Scan {
  id          String      @id @default(uuid()) @db.Uuid
  apiId       String      @db.Uuid
  jobId       String?     @unique @db.Uuid
  status      ScanStatus  @default(RUNNING)
  startedAt   DateTime    @default(now()) @db.Timestamptz(3)
  completedAt DateTime?   @db.Timestamptz(3)
  error       String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  api         TrackedApi  @relation(fields: [apiId], references: [id], onDelete: Cascade)
  job         ScanJob?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([apiId, createdAt])
}

model ScanJob {
  id             String        @id @default(uuid()) @db.Uuid
  apiId          String        @db.Uuid
  status         ScanJobStatus @default(PENDING)
  correlationId  String        @default(uuid())
  source         ScanJobSource @default(MANUAL)
  scheduleKey    String?       @unique
  attempt        Int           @default(0)
  maxAttempts    Int           @default(4)
  scheduledFor   DateTime      @default(now()) @db.Timestamptz(3)
  claimedAt      DateTime?     @db.Timestamptz(3)
  startedAt      DateTime?     @db.Timestamptz(3)
  leaseExpiresAt DateTime?     @db.Timestamptz(3)
  claimToken     String?       @db.Uuid
  runnerId       String?
  completedAt    DateTime?     @db.Timestamptz(3)
  failedAt       DateTime?     @db.Timestamptz(3)
  lastError      String?
  lastDeliveredAt DateTime?    @db.Timestamptz(3)
  redeliveryCount Int          @default(0)
  deadLetteredAt DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  api            TrackedApi    @relation(fields: [apiId], references: [id], onDelete: Cascade)
  scan           Scan?
  outboxMessages OutboxMessage[]

  @@index([status, scheduledFor, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([apiId, createdAt])
  @@index([status, createdAt])
}

model OutboxMessage {
  id           String       @id @default(uuid()) @db.Uuid
  jobId        String?      @db.Uuid
  apiId        String?      @db.Uuid
  topic        String
  routingKey   String
  payload      Json         @db.JsonB
  status       OutboxStatus @default(PENDING)
  attemptCount Int          @default(0)
  lockedAt     DateTime?    @db.Timestamptz(3)
  lockToken    String?      @db.Uuid
  publishedAt  DateTime?    @db.Timestamptz(3)
  lastError    String?
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  job          ScanJob?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  api          TrackedApi?  @relation(fields: [apiId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([status, lockedAt])
  @@index([jobId, createdAt])
}

model Worker {
  id         String       @id @default(uuid()) @db.Uuid
  name       String       @unique
  type       String
  baseUrl    String
  lastSeenAt DateTime?    @db.Timestamptz(3)
  status     WorkerStatus @default(UNKNOWN)
}
